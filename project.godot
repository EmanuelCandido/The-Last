[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="trees"
3d_physics/layer_3="player"
3d_physics/layer_4="animals"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/ssao/quality=1
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

wind_direction={
"type": "vec2",
"value": Vector2(1, 0.35)
}
wind_intensity={
"type": "float",
"value": 0.5
}
wind_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
wind_gust_scale={
"type": "float",
"value": 70.0
}
wind_gust_noise={
"type": "sampler2D",
"value": "res://assets/textures/macro_noise.png"
}
wind_exposure={
"type": "sampler2D",
"value": ""
}
wind_exposure_rect={
"type": "vec4",
"value": Vector4(-1, -1, 2, 2)
}
terrain_height={
"type": "sampler2D",
"value": ""
}
terrain_height_rect={
"type": "vec4",
"value": Vector4(-1, -1, 2, 2)
}
goblin_mud={
"type": "float",
"value": 0.0
}
