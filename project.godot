; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Jogo Pessoal"
config/description="Jogo 3D leve feito em Godot 4."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/events.gd"
Settings="*res://autoload/settings.gd"
Wind="*res://autoload/wind.gd"
Inventory="*res://autoload/inventory.gd"
Clock="*res://autoload/clock.gd"
Weather="*res://autoload/weather.gd"
Vitals="*res://autoload/vitals.gd"
Story="*res://autoload/story.gd"
Game="*res://autoload/game.gd"
SaveSystem="*res://autoload/save_system.gd"
MetaFiles="*res://autoload/meta_files.gd"
DevTools="*res://autoload/dev_tools.gd"
Playtest="*res://autoload/playtest.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/ui_theme.tres"

